<Window x:Class="WindowOpacity.UI.OpacityPopup" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WindowOpacity.UI" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowActivated="False" ShowInTaskbar="False" FontFamily="Segoe UI" Width="280" Height="276" UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Grayscale">
    <Grid Margin="10">
        <!-- Only the background is rasterized for the shadow. Text stays on its own layer. -->
        <Border CornerRadius="22" Background="{DynamicResource GlassSurface}" IsHitTestVisible="False">
            <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.18"/></Border.Effect>
        </Border>
        <Border CornerRadius="22" Background="Transparent" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="24,20">
            <StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><ui:OpacitySymbol Foreground="{DynamicResource Text}" Margin="0,0,10,0"/><TextBlock Text="Transparency" FontSize="15" FontWeight="Medium" VerticalAlignment="Center" Foreground="{DynamicResource Text}"/></StackPanel>
                <TextBlock x:Name="Percentage" Text="70%" HorizontalAlignment="Center" Margin="0,15,0,8" FontSize="32" FontWeight="SemiBold" Foreground="{DynamicResource Text}"/>
                <Slider x:Name="OpacitySlider" Minimum="20" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <DockPanel Margin="0,3,0,14"><TextBlock x:Name="MinimumPercentage" Text="20%" Foreground="{DynamicResource Muted}" FontSize="11" DockPanel.Dock="Left"/><TextBlock Text="100%" Foreground="{DynamicResource Muted}" FontSize="11" HorizontalAlignment="Right"/></DockPanel>
                <Button x:Name="ResetButton" Content="Reset" Width="112" HorizontalAlignment="Center" Margin="0" Padding="14,7"/>
                <TextBlock x:Name="ErrorText" FontSize="10" Foreground="#D55050" TextWrapping="Wrap" Margin="0,5,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
