<Window x:Class="WindowOpacity.UI.TransparencyOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="clr-namespace:WindowOpacity.UI" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowActivated="False" ShowInTaskbar="False" Width="46" Height="30" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Button x:Name="Control" ToolTip="Transparency" Focusable="False" Margin="0" Padding="0" Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Text}">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <!-- One alpha step keeps the whole invisible area clickable. -->
                <Grid Background="#01000000">
                    <ui:OpacitySymbol x:Name="Icon" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:OpacitySymbol.Effect><DropShadowEffect Color="{DynamicResource IconContrastColor}" BlurRadius="2" ShadowDepth="0" Opacity="0.75"/></ui:OpacitySymbol.Effect>
                    </ui:OpacitySymbol>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Icon" Property="Foreground" Value="#4AA3FF"/></Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Icon" Property="Foreground" Value="#0078D4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</Window>
